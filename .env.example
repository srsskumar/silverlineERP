# Copy to .env and fill in dev values. Never commit .env.
POSTGRES_USER=silverline
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://silverline:change-me@localhost:5440/silverline_dev
TEST_DATABASE_URL=postgresql://silverline:change-me@localhost:5440/silverline_test

# Database TLS. Loopback hosts default to `disable`; everything else defaults to
# `verify-full`, so a remote database is certificate-verified unless you opt out.
#   verify-full  verify the server certificate (default off-loopback)
#   no-verify    encrypt without verifying — refused in production unless
#                DATABASE_SSL_ALLOW_NO_VERIFY=true
#   disable      no TLS
# Several managed providers front connections with a self-signed chain that
# Node's bundled CAs do not validate (Supabase's pooler is one). Supply their CA
# rather than turning verification off where you can:
# DATABASE_SSL=verify-full
# DATABASE_CA_CERT_FILE=./certs/provider-ca.crt
JWT_SECRET=dev-secret-change-me
ENCRYPTION_KEY=64-hex-chars-from-openssl-rand-hex-32
PORT=3101
# API log threshold: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info
# Peers allowed to say where a request came from (X-Forwarded-For). Default
# trusts loopback only, which is right for nginx on the same host. Set to the
# proxy's address if it runs elsewhere; "true" only if nothing else can reach
# the API.
# TRUST_PROXY=127.0.0.1,::1
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
UPLOADS_DIR=./uploads
NEXT_PUBLIC_API_URL=http://localhost:3101
EXPO_PUBLIC_API_URL=http://localhost:3101
# Expo Go fallback tiles. Keep the URL replaceable; production may use a hosted
# provider or the configured Google Maps SDK in a Silverline development build.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Button-triggered Web place search. Public Nominatim requires identification,
# one request/second and caching; the API enforces the latter two.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=SilverlineERP/1.0
REPORTS_DIR=./exports
PUSH_ENABLED=false
# Set these for production file scanning; keep ClamAV on a private network.
# MALWARE_SCANNER_HOST=clamav
# MALWARE_SCANNER_PORT=3310
# Serverless hosts cannot run a ClamAV sidecar. Setting this accepts, in
# writing, that uploads are validated (signature, extension, 5 MiB cap) but not
# virus-scanned. Without it, production refuses uploads when no scanner is
# reachable. The API logs a warning at boot whenever it is on.
# MALWARE_SCANNER_DISABLED=true
# SEED_ADMIN_PASSWORD=<unique bootstrap password, at least 12 characters>

# Vendor-neutral integration gateways. Keep disabled until a production adapter is configured.
# All URLs must use HTTPS. Tokens belong only on the API/worker; never EXPO_PUBLIC_/NEXT_PUBLIC_.
PROVIDER_SMS_ENABLED=false
PROVIDER_SMS_URL=
PROVIDER_SMS_TOKEN=
PROVIDER_WHATSAPP_ENABLED=false
PROVIDER_WHATSAPP_URL=
PROVIDER_WHATSAPP_TOKEN=
PROVIDER_WEATHER_ENABLED=false
PROVIDER_WEATHER_URL=
PROVIDER_WEATHER_TOKEN=
PROVIDER_ACCOUNTING_ENABLED=false
PROVIDER_ACCOUNTING_URL=
PROVIDER_ACCOUNTING_TOKEN=
