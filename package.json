{
  "name": "silverline-erp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20 <24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "check": "npm run lint && npm test && npm run catalogue && npm run build",
    "db:migrate": "npm run migrate --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api",
    "catalogue": "node scripts/catalogue-coverage.mjs",
    "catalogue:json": "node scripts/catalogue-coverage.mjs --json",
    "test:survey": "npm run build --workspace=@silverline/shared && npm run test --workspace=@silverline/shared && npm run test:survey --workspace=apps/api && npm run test --workspace=apps/web"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^30.1.0",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "overrides": {
    "postcss": "8.5.28",
    "xcode": {
      "uuid": "11.1.1"
    },
    "query-string": "9.5.1",
    "vite": "7.3.6"
  }
}
