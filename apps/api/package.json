{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-api-assets.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "worker": "tsx src/jobs.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@silverline/shared": "0.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
