{
  "expo": {
    "name": "Silverline ERP",
    "slug": "silverline-erp",
    "version": "1.0.0",
    "scheme": "silverline",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is attached to attendance punches to record where you worked.",
        "NSCameraUsageDescription": "Camera is used to capture task evidence photos.",
        "NSFaceIDUsageDescription": "Biometrics unlock the app without re-entering your password.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "bundleIdentifier": "com.silverline.erp"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.silverline.erp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is attached to attendance punches to record where you worked.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is used to capture task evidence photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a56db"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of a receipt to attach to your expense claim.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-splash-screen",
      "expo-background-task",
      "expo-sharing",
      "expo-maps"
    ]
  }
}