#!/usr/bin/env bash
# Rebuild and restart Silverline from whatever source is in /opt/silverline.
#
# Push new source with rsync from a workstation, then run this:
#   rsync -az --delete --exclude-from=scripts/vm/rsync-exclude.txt \
#         ./ dev-thor:/opt/silverline/
#   ssh dev-thor sudo silverline-deploy
#
# From a workstation without rsync (Windows), ship the committed tree and let
# the VM's rsync do the same job. core.autocrlf=false matters: with it on,
# git archive writes CRLF, and this script's own `#!/usr/bin/env bash` line
# then fails as `bash\r`.
#   git -c core.autocrlf=false archive HEAD | ssh dev-thor \
#     'rm -rf /tmp/sl-stage && mkdir /tmp/sl-stage && tar -x -C /tmp/sl-stage'
#   ssh dev-thor 'rsync -a --delete \
#     --filter="P apps/api/uploads/" --filter="P exports/" --filter="P artifacts/*.apk" \
#     --exclude-from=/tmp/sl-stage/scripts/vm/rsync-exclude.txt \
#     /tmp/sl-stage/ /opt/silverline/ && sudo silverline-deploy'
# The P filters keep what exists only on the VM: files uploaded before
# UPLOADS_DIR moved to /var/lib/silverline, old encrypted exports, and the
# Android preview build.
#
# The exclusions live in a file rather than in this comment because the list
# was being retyped by hand each time, and one of them got left off: local
# tooling state under .gstack rode along to the VM, including a browser
# audit log with plaintext passwords in it, world-readable. A list nobody
# retypes is a list nobody can leave a line out of.
#
# Runtime data lives in /var/lib/silverline, deliberately outside the tree
# rsync --delete owns. Uploads used to sit under /opt/silverline and a deploy
# removed them, which stopped the API dead: its unit mounts that path through
# ReadWritePaths, so systemd failed at namespace setup and never reached node.
# Every request 502d and the log said only "No such file or directory".
set -euo pipefail
cd /opt/silverline

# Run the version that was just pushed, not the one installed last time.
#
# This script lives in the tree and is also installed on PATH, and the two
# drifted: a change to the deploy steps was committed, pushed and rsynced, and
# every deploy afterwards silently ran the old installed copy. Nothing said so
# — the deploy succeeded, it just did not do the new thing.
#
# exec replaces the process before bash reads any further, so the running
# script is never modified underneath itself. The guard stops it looping if
# the two are somehow never equal.
if [ "${SILVERLINE_DEPLOY_REEXEC:-}" != "1" ] \
  && ! cmp -s "$0" /opt/silverline/scripts/vm/silverline-deploy; then
  echo "==> deploy script changed; re-running the pushed version"
  install -m 755 /opt/silverline/scripts/vm/silverline-deploy /usr/local/bin/silverline-deploy
  SILVERLINE_DEPLOY_REEXEC=1 exec /usr/local/bin/silverline-deploy "$@"
fi

# NEXT_PUBLIC_API_URL is baked into the bundle at build time, so it has to be
# the origin the browser will use. Change it here if a domain is put in front.
API_ORIGIN="${API_ORIGIN:-http://34.131.134.217}"

echo "==> installing dependencies"
sudo -u dev-thor npm ci --workspace=@silverline/shared --workspace=api --workspace=web --include-workspace-root

echo "==> building shared"
sudo -u dev-thor npm run build --workspace=@silverline/shared
echo "==> building api"
sudo -u dev-thor npm run build --workspace=api
echo "==> building web (API origin: $API_ORIGIN)"
sudo -u dev-thor env NEXT_VERIFY_BUILD=1 NEXT_PUBLIC_API_URL="$API_ORIGIN" npm run build --workspace=web

# Copy the build into a release of its own, but do not put it live yet.
#
# nginx used to serve .next-verify directly, and `next build` empties that
# directory before it writes, so every deploy blanked the site for the length
# of the build. It goes live below, after the schema check and the API
# restart, so a deploy that stops early leaves the old web in front of the old
# API rather than new pages talking to an API that was never restarted.
WEB_RELEASES=/opt/silverline-web/releases
RELEASE="$WEB_RELEASES/$(date -u +%Y%m%dT%H%M%SZ)"
echo "==> staging web release $RELEASE"
mkdir -p "$WEB_RELEASES"
cp -a /opt/silverline/apps/web/.next-verify "$RELEASE"
rm -f "$RELEASE/_headers" "$RELEASE/_redirects"

# The worker units are shipped but deliberately not enabled here: switching
# the scheduler on for the first time fires every overdue report schedule at
# once and delivers a backlog of alerts, which is an operator's decision
# rather than a deploy's. Install with:
#   sudo systemctl enable --now silverline-worker.timer
# On dev-thor that decision has been made: the timer is enabled and a pass
# runs about every five minutes (systemctl list-timers silverline-worker.timer).
echo "==> installing worker units (not enabled)"
install -m 644 /opt/silverline/scripts/vm/silverline-worker.service /etc/systemd/system/
install -m 644 /opt/silverline/scripts/vm/silverline-worker.timer /etc/systemd/system/
systemctl daemon-reload

# Stop before the restart, not after it.
#
# The API refuses to start against a schema older than the code, which is
# right — serving routes whose columns do not exist yet turns every request
# into an opaque 500. But nothing here applied migrations, so a deploy
# carrying one took the API down and left it down until somebody read the
# journal and ran the migration by hand.
#
# Migrations stay a deliberate step rather than something a deploy does on its
# own: applying schema changes to production is a decision with a rollback
# plan attached, not a side effect of pushing code. So this only checks, and
# refuses to restart into an outage it can see coming. The old build keeps
# serving in the meantime.
echo "==> checking the schema is current"
# Skippable, because a check that breaks must not become a new way to block
# every deploy: SKIP_SCHEMA_CHECK=1 silverline-deploy
if [ "${SKIP_SCHEMA_CHECK:-}" = "1" ]; then
  echo "   skipped (SKIP_SCHEMA_CHECK=1)"
else
  # The same environment file the service reads, so this asks the same
  # database. Passed through `env` rather than `sudo -E`, which this box
  # refuses with "preserving the entire environment is not supported" — and
  # refuses on stderr, so the variable simply arrived empty.
  set +e
  PENDING=$(
    set -a; . /etc/silverline/api.env; set +a
    cd /opt/silverline/apps/api && sudo -u dev-thor \
      env DATABASE_URL="$DATABASE_URL" npx tsx -e '
// Wrapped, because `tsx -e` compiles to CJS and CJS has no top-level await.
const { readdirSync } = require("node:fs");
const pg = require("pg");
(async () => {
  const url = process.env.DATABASE_URL;
  if (!url) throw new Error("DATABASE_URL is not set in /etc/silverline/api.env");
  const dir = "/opt/silverline/apps/api/src/database/migrations";
  const onDisk = readdirSync(dir)
    .filter(f => f.endsWith(".sql"))
    .map(f => f.replace(/\.sql$/, ""))
    .sort();
  const c = new pg.Client({ connectionString: url });
  await c.connect();
  const applied = new Set(
    (await c.query("SELECT version FROM schema_migrations")).rows.map(r => r.version));
  await c.end();
  console.log("PENDING:" + onDisk.filter(v => !applied.has(v)).join(","));
})();
' 2>&1
  )
  CHECK_STATUS=$?
  set -e

  if [ "$CHECK_STATUS" -ne 0 ] || ! printf '%s' "$PENDING" | grep -q "PENDING:"; then
    # Loud, never silent. An earlier version hid this behind 2>/dev/null and
    # set -e killed the deploy with no message at all.
    echo "!! Could not check the schema. The API refuses to start against a schema"
    echo "   older than the code, so restarting now risks taking it down."
    echo "   What the check said:"
    printf '%s\n' "$PENDING" | sed 's/^/     /'
    echo "   Verify by hand, or re-run with SKIP_SCHEMA_CHECK=1 to go ahead anyway."
    exit 1
  fi

  PENDING=$(printf '%s' "$PENDING" | grep -o 'PENDING:.*' | cut -d: -f2-)
  if [ -n "$PENDING" ]; then
    echo "!! Not restarting: these migrations have not been applied yet:"
    echo "     $PENDING"
    echo "   The running API is still serving the previous build, so nothing is down."
    echo "   Apply them, then run this again:"
    echo "     cd /opt/silverline/apps/api \\"
    echo "       && sudo -u dev-thor env DATABASE_URL=\"\$DATABASE_URL\" npx tsx src/database/migrate.ts"
    exit 1
  fi
  echo "   up to date"
fi

echo "==> restarting"
# The API unit comes from the tree too, so a change to it is reviewed like any
# other. Only reloaded when it differs, and before the restart that uses it.
if ! cmp -s /opt/silverline/scripts/vm/silverline-api.service /etc/systemd/system/silverline-api.service; then
  echo "==> installing the API unit"
  install -m 644 /opt/silverline/scripts/vm/silverline-api.service /etc/systemd/system/
  systemctl daemon-reload
fi
systemctl restart silverline-api

sleep 3
systemctl is-active --quiet silverline-api || { echo "API did not come back:"; journalctl -u silverline-api -n 30 --no-pager; exit 1; }

# Now the web. A symlink swap by rename, so nginx sees the old release or the
# new one and never a half-written directory.
echo "==> web release live: $RELEASE"
ln -sfn "$RELEASE" /opt/silverline-web/current.next
mv -T /opt/silverline-web/current.next /opt/silverline-web/current

# Keep five, so a bad web build is one symlink away from the one before it:
#   ls /opt/silverline-web/releases
#   sudo ln -sfn /opt/silverline-web/releases/<previous> /opt/silverline-web/current
ls -1d "$WEB_RELEASES"/*/ | sort | head -n -5 | xargs -r rm -rf

# The nginx site from the tree, and only if nginx accepts it: a config that
# fails `nginx -t` is put back, so the running server keeps the last good one.
SITE=/etc/nginx/sites-available/silverline
if ! cmp -s /opt/silverline/scripts/vm/nginx-silverline.conf "$SITE"; then
  echo "==> installing the nginx site"
  cp -a "$SITE" "$SITE.previous" 2>/dev/null || true
  install -m 644 /opt/silverline/scripts/vm/nginx-silverline.conf "$SITE"
  ln -sfn "$SITE" /etc/nginx/sites-enabled/silverline
  if ! nginx -t 2>&1; then
    echo "!! nginx rejected the new site; putting the previous one back"
    mv "$SITE.previous" "$SITE"
    exit 1
  fi
fi
systemctl reload nginx

curl -fsS http://127.0.0.1/health >/dev/null && echo "==> live: $API_ORIGIN"
