{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        ".next-verify/**",
        "out/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "ENCRYPTION_KEY",
        "REPORTS_DIR",
        "PUSH_ENABLED"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "EXPO_PUBLIC_API_URL",
    "CI",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "DATABASE_URL",
    "DIRECT_URL",
    "TEST_DATABASE_URL",
    "JWT_SECRET",
    "ENCRYPTION_KEY",
    "PORT",
    "CORS_ORIGIN",
    "UPLOADS_DIR",
    "REPORTS_DIR",
    "BCRYPT_ROUNDS",
    "LOGIN_RATE_LIMIT_MAX",
    "PUNCH_RATE_LIMIT_MAX",
    "PUSH_ENABLED"
  ]
}
